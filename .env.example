# Copy this to .env.local for local dev, and add these as GitHub Actions secrets for CI/CD

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=deal-analyzer-fe1f3.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=deal-analyzer-fe1f3
REACT_APP_FIREBASE_STORAGE_BUCKET=deal-analyzer-fe1f3.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# URL of your deployed Cloudflare Worker (see cloudflare-worker/README section below)
REACT_APP_LISTING_PARSER_URL=https://deal-analyzer-listing-parser.YOUR-SUBDOMAIN.workers.dev

# The Anthropic key itself is NOT set here — it lives only in the Worker,
# set once with (from inside cloudflare-worker/):
#   wrangler secret put ANTHROPIC_API_KEY
# (paste your key from https://console.anthropic.com/settings/api-keys when prompted)
